# Copie para .env e preencha. NUNCA versione o .env (ele está no .gitignore).

# LLM da camada de explicação (GroqCloud). Sem chave, o sistema usa as mensagens-padrão.
GROQ_API_KEY=
GROQ_MODELO=llama-3.1-8b-instant

# Banco da aplicação. Vazio = SQLite local em prototipo/dados/agroanalise.db. No deploy, use um Postgres gerenciado.
DATABASE_URL=

# Token que o gateway usa em POST /leituras (Authorization: Bearer ...). Vazio = recebimento desligado (503).
TOKEN_DISPOSITIVO=

# De onde as páginas leem o estado dos talhões: simulada (padrão) ou banco (leituras enviadas pelo gateway).
FONTE_LEITURAS=simulada
# Leitura mais antiga que isso (minutos) vira "sem dados atualizados" (cinza). Use 1 para demonstrar ao vivo.
MINUTOS_DESATUALIZADO=15
# Intervalo esperado entre envios de um ponto (minutos), usado no indicador de disponibilidade.
INTERVALO_LEITURA_MIN=10

# Etapa 5 (segurança e deploy): MODO_DEMO, ORIGENS_PERMITIDAS.
MODO_DEMO=
ORIGENS_PERMITIDAS=
