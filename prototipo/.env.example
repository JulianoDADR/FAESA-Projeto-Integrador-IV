# Copie para .env e preencha. NUNCA versione o .env (ele está no .gitignore).

# LLM da camada de explicação (GroqCloud). Sem chave, o sistema usa as mensagens-padrão.
GROQ_API_KEY=
GROQ_MODELO=openai/gpt-oss-20b

# Turso/libSQL no deploy (recomendado na Vercel). Copie a URL do painel; o token só vai em TURSO_AUTH_TOKEN.
# Preencha apenas no .env local ou nas variáveis de ambiente do provedor; nunca versione estes valores.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Banco alternativo (SQLite local ou outra URL libsql://). Vazio = SQLite em prototipo/dados/agroanalise.db.
# A ordem de precedência é: TURSO_DATABASE_URL + TURSO_AUTH_TOKEN, DATABASE_URL e, por fim, o SQLite local.
# Outro banco (ex.: Postgres) exigiria instalar o driver correspondente no requirements.txt.
DATABASE_URL=

# Token que o gateway usa em POST /leituras (Authorization: Bearer ...). Vazio = recebimento desligado (503).
TOKEN_DISPOSITIVO=

# De onde as páginas leem o estado dos talhões: simulada (padrão) ou banco (leituras enviadas pelo gateway).
FONTE_LEITURAS=simulada
# Leitura mais antiga que isso (minutos) vira "sem dados atualizados" (cinza). Use 1 para demonstrar ao vivo.
MINUTOS_DESATUALIZADO=15
# Intervalo esperado entre envios de um ponto (minutos), usado no indicador de disponibilidade.
INTERVALO_LEITURA_MIN=10

# Teto de chamadas ao Groq (ao estourar, mensagem-padrão). Ajuste abaixo dos limites do console do Groq.
GROQ_MAX_POR_MINUTO=20
GROQ_MAX_POR_DIA=1000

# 1 = libera "Simular falha do LLM" e /simulador/leituras. Vazio = desligado (produção).
MODO_DEMO=1
# Lista separada por vírgulas, só se outro site precisar chamar a API (CORS). Vazio = só a própria origem.
ORIGENS_PERMITIDAS=
# 1 = grava uma leitura simulada por talhão a cada INTERVALO_LEITURA_MIN (demo sem gateway). Desligue com gateway real.
# Na Vercel o alimentador é sempre desligado (função serverless não mantém tarefa em segundo plano).
ALIMENTADOR_DEMO=
# 1 = se o banco estiver vazio ao iniciar, grava 72 h de leituras simuladas.
SEMEAR_SE_VAZIO=
